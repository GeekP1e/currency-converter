{
  "manifest_version": 3,
  "name": "Точный конвертер валют",
  "version": "1.0.1",
  "description": "Конвертация KZT, RUB, USD, EUR и CNY по официальным курсам Национального Банка Казахстана.",
  "permissions": ["storage"],
  "host_permissions": ["https://nationalbank.kz/*"],
  "action": {
    "default_title": "Конвертер валют",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
