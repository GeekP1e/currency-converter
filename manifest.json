{
  "manifest_version": 3,
  "name": "Точный конвертер валют",
  "version": "1.0.0",
  "description": "Конвертация KZT, RUB, USD, EUR и CNY по официальным курсам Национального Банка Казахстана.",
  "permissions": ["storage"],
  "host_permissions": ["https://nationalbank.kz/*"],
  "action": {
    "default_title": "Конвертер валют",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kzt-currency-converter@local",
      "strict_min_version": "109.0"
    }
  }
}
